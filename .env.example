# ─────────────────────────────────────────────
# Database (Neon Postgres with pgvector enabled)
# ─────────────────────────────────────────────
# Get this from https://console.neon.tech (use the pooled connection string).
# Run `CREATE EXTENSION IF NOT EXISTS vector;` once on your database.
DATABASE_URL="postgresql://user:password@ep-xxx.aws.neon.tech/yxuos?sslmode=require"

# Optional: set to "true" if your Postgres requires SSL (Neon does)
DATABASE_SSL="true"

# ─────────────────────────────────────────────
# Better Auth
# ─────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# OAuth providers (add as you wire them up)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─────────────────────────────────────────────
# AI providers
# ─────────────────────────────────────────────
# Vercel AI Gateway (recommended – one key, hundreds of models)
AI_GATEWAY_API_KEY=""

# Or direct provider keys
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Azure AI Foundry — OpenAI-compatible endpoint.
# Base URL pattern: https://<resource>.services.ai.azure.com
AZURE_OPENAI_BASE_URL=""
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_MODEL="gpt-oss-120b"

# ─────────────────────────────────────────────
# Embeddings (project brain / RAG)
# ─────────────────────────────────────────────
# Pick ONE of these. The Azure pair takes priority if both are set.
#
# Azure AI Foundry (recommended for production — uses the
# `text-embedding-3-large` deployment with dimensions=1536 to stay
# compatible with the vector(1536) DB column):
AZURE_EMBEDDINGS_ENDPOINT=""            # e.g. https://<resource>.services.ai.azure.com
AZURE_EMBEDDINGS_API_KEY=""
AZURE_EMBEDDINGS_DEPLOYMENT="text-embedding-3-large"
# Or use OPENAI_API_KEY above with text-embedding-3-small (1536 dims native).

# ─────────────────────────────────────────────
# Mastra
# ─────────────────────────────────────────────
# Mastra reuses DATABASE_URL for PostgresStore + PgVector.
# Set MASTRA_TELEMETRY_DISABLED=1 to opt out of anonymous telemetry.
MASTRA_TELEMETRY_DISABLED=""

# ─────────────────────────────────────────────
# Integrations (Module 7 – wire up as needed)
# ─────────────────────────────────────────────
# GitHub App for repo ingestion / webhooks
# ─── GitHub App (repo ingestion + webhooks) ───────────────────
# Numeric App ID from github.com → Settings → Developer settings → GitHub Apps
GITHUB_APP_ID=""
# OAuth client credentials issued alongside the App (used by the install flow).
GITHUB_APP_CLIENT_ID=""
GITHUB_APP_CLIENT_SECRET=""

GITHUB_APP_PRIVATE_KEY=""
GITHUB_APP_PRIVATE_KEY_B64=""
# Webhook secret. Whatever you typed into the App's "Webhook secret"
# field on github.com — must match byte-for-byte.
GITHUB_WEBHOOK_SECRET=""

# ─────────────────────────────────────────────
# App
# ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
ANTHROPIC_API_KEY=your-api-key

# ─────────────────────────────────────────────
# Cache (Upstash Redis REST) — optional
# ─────────────────────────────────────────────
# When set, the app caches expensive read paths (permissions, project
# listings, default task boards, …) in Upstash. Without these the app
# still uses a per-request in-memory memo — faster than before, but
# cross-request hits go straight to Postgres. Get the credentials at
# https://console.upstash.com/redis → your DB → "REST API".
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Namespace prepended to every Redis key. Default \`y\`. Use distinct
# values per environment if multiple deployments share one Upstash DB.
CACHE_NAMESPACE="y"


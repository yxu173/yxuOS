# ─────────────────────────────────────────────
# Database (Neon Postgres with pgvector enabled)
# ─────────────────────────────────────────────
# Get this from https://console.neon.tech (use the pooled connection string).
# Run `CREATE EXTENSION IF NOT EXISTS vector;` once on your database.
DATABASE_URL="postgresql://user:password@ep-xxx.aws.neon.tech/yxuos?sslmode=require"

# Optional: set to "true" if your Postgres requires SSL (Neon does)
DATABASE_SSL="true"

# ─────────────────────────────────────────────
# Better Auth
# ─────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# OAuth providers (add as you wire them up)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─────────────────────────────────────────────
# AI providers
# ─────────────────────────────────────────────
# Vercel AI Gateway (one key, hundreds of models)
AI_GATEWAY_API_KEY=""

# Direct provider keys (fallback / specific use)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Azure AI Foundry — Anthropic Messages-compatible endpoint.
# This is what the board agent uses by default (claude-opus-4-7-1).
# Base URL like https://<your-resource>.services.ai.azure.com/anthropic
AZURE_ANTHROPIC_BASE_URL=""
AZURE_ANTHROPIC_API_KEY=""
# Optional: override the deployed model id. Default: claude-opus-4-7-1
AZURE_ANTHROPIC_MODEL=""

# ─────────────────────────────────────────────
# Object storage (Vercel Blob)
# ─────────────────────────────────────────────
# Required for the design asset library (logo / image uploads).
# Get one at https://vercel.com/dashboard → Storage → Blob → connect to your project.
BLOB_READ_WRITE_TOKEN=""

# ─────────────────────────────────────────────
# Mastra
# ─────────────────────────────────────────────
# Mastra reuses DATABASE_URL for PostgresStore + PgVector.
# Set MASTRA_TELEMETRY_DISABLED=1 to opt out of anonymous telemetry.
MASTRA_TELEMETRY_DISABLED=""

# ─────────────────────────────────────────────
# Integrations (Module 7 – wire up as needed)
# ─────────────────────────────────────────────
# GitHub App for repo ingestion / webhooks
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_WEBHOOK_SECRET=""

# Figma personal access token / OAuth
FIGMA_ACCESS_TOKEN=""

# Slack
SLACK_BOT_TOKEN=""
SLACK_SIGNING_SECRET=""

# ─────────────────────────────────────────────
# App
# ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Show the in-canvas debug toolbar that lets you drop test markdown / mermaid
# cards by hand. Set to "1" while developing, leave empty in production.
NEXT_PUBLIC_SHOW_DEV_TOOLBAR=""
ANTHROPIC_API_KEY=your-api-key
